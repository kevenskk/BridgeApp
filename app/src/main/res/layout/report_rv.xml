<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:elevation="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:orientation="vertical">



        <TextView
            android:id="@+id/idTVBridgeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:padding="3dp"
            android:text="Bridge Name"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/labelDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:padding="3dp"
            android:text="Inspection Date:"
            android:textColor="@color/black" />



            <TextView
                android:id="@+id/idTVBridgeDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:padding="3dp"
                android:text="Bridge Date"
                android:textColor="@color/black" />


            <TextView
                android:id="@+id/idTVBridgeLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:padding="3dp"
                android:text="Bridge Location"
                android:textColor="@color/black" />



        <TextView
            android:id="@+id/labelState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:padding="3dp"
            android:text="State of bridge:"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/idTVBridgeState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:padding="3dp"
            android:text="Bridge State"
            android:textColor="@color/black" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

